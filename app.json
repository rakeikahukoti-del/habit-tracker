{
  "expo": {
    "name": "Momentum",
    "slug": "mobile-habit-tracker",
    "version": "1.0.0",
    "orientation": "portrait",
    "platforms": [
      "ios",
      "android"
    ],
    "scheme": "habittracker",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0F1115",
    "icon": "./assets/branding/app-icon-dark.png",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/branding/splash-logo.png",
      "backgroundColor": "#0F1115",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/branding/adaptive-foreground.png",
        "backgroundColor": "#0F1115"
      }
    },
    "androidNavigationBar": {
      "backgroundColor": "#0F1115",
      "barStyle": "light-content"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
